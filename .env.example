# Document Screening Engine - example environment configuration
# Copy this file to `.env` and adjust values for your deployment.
# Every variable is optional; defaults keep the service usable out of the box.
# Provide real secrets (ADMIN_PASSWORD) at deployment time.

API_ENV=development
LOG_LEVEL=INFO

# CORS: comma-separated origins (legacy name ALLOWED_ORIGINS still works)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=10
# MAX_IMAGE_BYTES=10485760                  # explicit override (takes precedence over MAX_FILE_SIZE_MB)
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# MRZ
MRZ_CONFIDENCE_THRESHOLD=0.70
MRZ_YEAR_PIVOT=50                          # years 00-49 -> 20xx, years 50-99 -> 19xx

# Face recognition (InsightFace / ArcFace embeddings; L2-normalized cosine)
FACE_MODEL_NAME=buffalo_sc
FACE_MODELS_DIR=~/.insightface               # where the model pack is stored/downloaded
FACE_DET_SIZE=640
FACE_CTX_ID=-1                              # -1 = CPU
FACE_MATCH_THRESHOLD=0.35                   # ArcFace cosine threshold (legacy name
                                            # FACE_SIMILARITY_THRESHOLD still works)
FACE_MIN_DETECTION_CONFIDENCE=0.50
FACE_MIN_QUALITY=0.20

# Tampering analysis (multi-signal heuristic: ELA, compression, noise, edge,
# copy-move, metadata).                 score >= threshold      -> SUSPICIOUS
#                              review <= score < threshold     -> INCONCLUSIVE
TAMPERING_THRESHOLD=70.0
TAMPERING_REVIEW_THRESHOLD=45.0

# Risk thresholds (0 <= review < reject <= 100)
RISK_REVIEW_THRESHOLD=35                   # legacy name RISK_MEDIUM_THRESHOLD still works
RISK_REJECT_THRESHOLD=65                   # legacy name RISK_HIGH_THRESHOLD still works

# Risk factor weights (heuristic, not probabilities). Unknown factors are
# treated as MODULE_ERROR / UNKNOWN_FACTOR and never silently assigned a weight.
RISK_TAMPERING=40
RISK_TAMPERING_INCONCLUSIVE=15
RISK_FACE_MISMATCH=35
RISK_FACE_NOT_DETECTED=20
RISK_FACE_LOW_CONFIDENCE=15
RISK_FACE_MULTIPLE=20
RISK_MRZ_CHECKSUM=20
RISK_EXPIRED=25
RISK_MRZ_NOT_DETECTED=20
RISK_MRZ_LOW_CONFIDENCE=10
RISK_IMAGE_QUALITY=10
RISK_MODULE_ERROR=25
RISK_UNKNOWN_MODULE=15

# Audit database (PostgreSQL recommended; any SQLAlchemy URL works). Raw
# images, embeddings, MRZ text, and passport numbers are never stored.
# Local default: SQLite.
DATABASE_URL=sqlite:///./document_screening.db
# Recommended (PostgreSQL, e.g. via docker compose):
# DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5432/screening
AUTH_TOKEN_TTL_HOURS=24

# DB bring-up behaviour (PostgreSQL may still be starting when the API boots)
DB_CONNECT_TIMEOUT=5
DB_CONNECT_RETRIES=5
DB_RETRY_DELAY=1.0

# PostgreSQL service used by docker-compose (must match host part of DATABASE_URL)
POSTGRES_USER=screening
POSTGRES_PASSWORD=screening
POSTGRES_DB=screening

# Optional bootstrap admin created at startup when these are all set.
# MUST be overridden in real deployments.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now