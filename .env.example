# Document Screening Engine - example environment configuration
# Copy this file to `.env` and adjust values for your deployment.
# Every variable is optional; defaults keep the service usable out of the box.
# No secrets are defined by this prototype - add real secret handling at deployment.

API_ENV=development
LOG_LEVEL=INFO

# CORS: comma-separated origins (legacy name ALLOWED_ORIGINS still works)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=10
# MAX_IMAGE_BYTES=10485760            # explicit override (takes precedence over MAX_FILE_SIZE_MB)
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Screening thresholds
MRZ_CONFIDENCE_THRESHOLD=0.70
FACE_MATCH_THRESHOLD=0.60            # legacy name FACE_SIMILARITY_THRESHOLD still works
TAMPERING_THRESHOLD=60.0
MRZ_YEAR_PIVOT=50                    # years 00-49 -> 20xx, years 50-99 -> 19xx

# Risk thresholds (0 <= review < reject <= 100)
RISK_REVIEW_THRESHOLD=35             # legacy name RISK_MEDIUM_THRESHOLD still works
RISK_REJECT_THRESHOLD=65             # legacy name RISK_HIGH_THRESHOLD still works

# Risk factor weights (heuristic, not probabilities)
RISK_TAMPERING=40
RISK_TAMPERING_INCONCLUSIVE=15
RISK_FACE_MISMATCH=35
RISK_FACE_NOT_DETECTED=20
RISK_MRZ_CHECKSUM=20
RISK_EXPIRED=25
RISK_MRZ_NOT_DETECTED=20
RISK_UNKNOWN_MODULE=15